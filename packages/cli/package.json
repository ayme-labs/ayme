{
  "name": "@ayme-dev/cli",
  "version": "0.3.1",
  "description": "The ayme command. It runs your project's Page Objects for a coding agent beside its browser automation, and ayme capture records a browser flow on the Playwright your project already has, for the agent to turn into page objects and a test.",
  "keywords": [
    "ai-agent",
    "coding-agent",
    "browser-automation",
    "playwright",
    "page-object-model",
    "testing",
    "test-automation",
    "e2e",
    "recorder",
    "codegen"
  ],
  "homepage": "https://ayme.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayme-labs/ayme.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./package.json": "./package.json"
    }
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "ayme": "./dist/cli.mjs"
  },
  "exports": {
    "./testing": "./testing/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint src testing --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:crap": "vitest run --config vitest.fast.config.ts --coverage",
    "test:mutation": "stryker run"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.62"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "dependencies": {
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@ayme-dev/eslint-config": "workspace:*",
    "@ayme-dev/inspector": "workspace:*",
    "@ayme-dev/recorder": "workspace:*",
    "@ayme-dev/recorder-window": "workspace:*",
    "@ayme-dev/session": "workspace:*",
    "@ayme-dev/test-config": "workspace:*",
    "@ayme-dev/typescript-config": "workspace:*",
    "@modelcontextprotocol/server": "^2.4.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.9.1",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
