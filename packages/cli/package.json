{
  "name": "@ayme-dev/cli",
  "version": "0.0.0",
  "private": true,
  "description": "The Ayme Recorder's command line: records a flow on the Playwright your project already has",
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "bin": {
    "ayme-recorder": "./dist/cli.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:crap": "vitest run --config vitest.fast.config.ts --coverage",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@ayme-dev/recorder": "workspace:*"
  },
  "devDependencies": {
    "@ayme-dev/eslint-config": "workspace:*",
    "@ayme-dev/test-config": "workspace:*",
    "@ayme-dev/typescript-config": "workspace:*",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
