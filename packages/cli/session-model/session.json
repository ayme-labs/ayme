{
  "id": "session",
  "type": "parallel",
  "states": {
    "browser": {
      "initial": "tabs",
      "states": {
        "tabs": {
          "on": {
            "DIALOG_OPEN": {
              "guard": "canOpenDialog",
              "actions": "openDialog"
            },
            "DIALOG_CLOSE": {
              "guard": "canCloseDialog",
              "actions": "closeDialog"
            },
            "DIALOG_TIMEOUT": {
              "guard": "dialogAgesOutsideRun",
              "actions": "ageDialog"
            },
            "TAB_SWITCH": {
              "guard": "canSwitchTab",
              "actions": "switchTab"
            },
            "TAB_OPEN": {
              "guard": "canOpenTab",
              "actions": "openTab"
            },
            "TAB_CLOSE": {
              "guard": "canCloseTab",
              "actions": "closeTab"
            },
            "HIDE": {
              "guard": "canHide",
              "actions": "hide"
            },
            "SHOW": {
              "guard": "canShow",
              "actions": "show"
            },
            "NAVIGATE": {
              "guard": "canNavigate",
              "actions": "navigate"
            }
          }
        }
      }
    },
    "life": {
      "initial": "noSession",
      "states": {
        "noSession": {
          "on": {
            "OPEN": {
              "target": "starting",
              "guard": "canOpen",
              "actions": "startOwnBrowser"
            },
            "ATTACH": {
              "target": "starting",
              "guard": "canAttach",
              "actions": "joinBrowser"
            },
            "BROWSER_GONE": {
              "guard": "browserCanGo",
              "actions": "browserGone"
            }
          }
        },
        "starting": {
          "on": {
            "FIRST_BUILD": [
              {
                "target": "running",
                "guard": "firstBuildOk",
                "actions": "startSession"
              },
              {
                "target": "noSession",
                "guard": "firstBuildFails",
                "actions": "failStart"
              }
            ],
            "BROWSER_GONE": {
              "target": "noSession",
              "guard": "browserCanGo",
              "actions": "browserGoneDuringStart"
            }
          }
        },
        "running": {
          "on": {
            "BROWSER_GONE": {
              "target": "noSession",
              "guard": "browserCanGo",
              "actions": "endSessionBrowserGone"
            },
            "STOP_DONE": {
              "target": "noSession",
              "guard": "canEndSession",
              "actions": "endSession"
            },
            "STOPPED_END": {
              "guard": "stoppedActionCanEnd",
              "actions": "endStoppedAction"
            },
            "READ": {
              "guard": "canRead",
              "actions": "read"
            }
          },
          "initial": "pageObjects",
          "states": {
            "pageObjects": {
              "initial": "ready",
              "states": {
                "ready": {
                  "on": {
                    "EDIT": {
                      "target": "rebuilding",
                      "guard": "canEdit",
                      "actions": "edit"
                    }
                  }
                },
                "rebuilding": {
                  "on": {
                    "BUILD_DONE": [
                      {
                        "target": "waitingToSwap",
                        "guard": "buildOk",
                        "actions": "buildSucceeded"
                      },
                      {
                        "target": "ready",
                        "guard": "buildFails",
                        "actions": "buildFailed"
                      }
                    ],
                    "EDIT": {
                      "guard": "canEdit",
                      "actions": "edit"
                    }
                  }
                },
                "waitingToSwap": {
                  "on": {
                    "SWAP": {
                      "target": "ready",
                      "guard": "canSwap",
                      "actions": "swap"
                    },
                    "EDIT": {
                      "target": "rebuilding",
                      "guard": "canEdit",
                      "actions": "edit"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "opener": {
      "initial": "idle",
      "states": {
        "idle": {
          "on": {
            "OPEN": [
              {
                "target": "waiting",
                "guard": "canOpen"
              },
              {
                "guard": "openNameInUse",
                "actions": "refuseOpen"
              }
            ],
            "ATTACH": [
              {
                "target": "waiting",
                "guard": "canAttach"
              },
              {
                "guard": "attachNameInUse",
                "actions": "refuseOpen"
              }
            ]
          }
        },
        "waiting": {
          "on": {
            "OPENED": {
              "target": "idle",
              "guard": "sessionRunning",
              "actions": "answerOpened"
            },
            "OPEN_FAILED": {
              "target": "idle",
              "guard": "noSession",
              "actions": "answerOpenFailed"
            }
          }
        }
      }
    },
    "agent": {
      "initial": "idle",
      "states": {
        "idle": {
          "on": {
            "COMMAND": {
              "target": "waitingForStart",
              "guard": "canSendCommand",
              "actions": "sendCommand"
            }
          }
        },
        "waitingForStart": {
          "on": {
            "A_NO_SESSION": {
              "target": "idle",
              "guard": "noSession"
            },
            "A_BEGIN": [
              {
                "target": "listing",
                "guard": "beginListing",
                "actions": "bindAgentTab"
              },
              {
                "target": "waitingForTurn",
                "guard": "beginRun",
                "actions": "bindAgentTab"
              },
              {
                "target": "ending",
                "guard": "beginEnd"
              }
            ]
          }
        },
        "listing": {
          "on": {
            "A_DIALOG_OPEN": {
              "target": "idle",
              "guard": "agentTabHasDialog",
              "actions": "agentRefusedForDialog"
            },
            "A_NO_TAB": {
              "target": "idle",
              "guard": "agentTabGone"
            },
            "A_LIST": {
              "target": "idle",
              "guard": "agentCanList",
              "actions": "answerListing"
            },
            "BROWSER_GONE": {
              "target": "idle",
              "guard": "browserCanGo"
            },
            "STOP_DONE": {
              "target": "idle",
              "guard": "canEndSession"
            }
          }
        },
        "waitingForTurn": {
          "on": {
            "A_DIALOG_OPEN": {
              "target": "idle",
              "guard": "agentTabHasDialog",
              "actions": "agentRefusedForDialog"
            },
            "A_NO_TAB": {
              "target": "idle",
              "guard": "agentTabGone"
            },
            "A_TAB_HIDDEN": {
              "target": "idle",
              "guard": "agentTabHidden",
              "actions": "agentRefusedHidden"
            },
            "A_START": {
              "target": "running",
              "guard": "agentCanStart"
            },
            "BROWSER_GONE": {
              "target": "idle",
              "guard": "browserCanGo"
            },
            "STOP_DONE": {
              "target": "idle",
              "guard": "canEndSession"
            }
          }
        },
        "running": {
          "on": {
            "A_DONE": {
              "target": "idle",
              "guard": "agentRunCanEnd"
            },
            "DIALOG_TIMEOUT": {
              "target": "idle",
              "guard": "agentRunHitDialog",
              "actions": "stopAgentAction"
            },
            "TAB_CLOSE": {
              "target": "idle",
              "guard": "agentTabCloses"
            },
            "BROWSER_GONE": {
              "target": "idle",
              "guard": "browserCanGo"
            },
            "STOP_DONE": {
              "target": "idle",
              "guard": "canEndSession"
            }
          }
        },
        "ending": {
          "on": {
            "STOP_DONE": {
              "target": "idle",
              "guard": "canEndSession"
            },
            "A_REFUSED": {
              "target": "idle",
              "guard": "detachRefused"
            },
            "BROWSER_GONE": {
              "target": "idle",
              "guard": "browserCanGo"
            }
          }
        }
      }
    },
    "inspector": {
      "initial": "idle",
      "states": {
        "idle": {
          "on": {
            "RUN": {
              "target": "waitingForTurn",
              "guard": "canRunFromInspector",
              "actions": "bindInspectorTab"
            }
          }
        },
        "waitingForTurn": {
          "on": {
            "I_DIALOG_OPEN": {
              "target": "idle",
              "guard": "inspectorTabHasDialog",
              "actions": "inspectorRefusedForDialog"
            },
            "I_NO_TAB": {
              "target": "idle",
              "guard": "inspectorTabGone"
            },
            "I_TAB_HIDDEN": {
              "target": "idle",
              "guard": "inspectorTabHidden"
            },
            "I_START": {
              "target": "running",
              "guard": "inspectorCanStart"
            },
            "BROWSER_GONE": {
              "target": "idle",
              "guard": "browserCanGo"
            },
            "STOP_DONE": {
              "target": "idle",
              "guard": "canEndSession"
            }
          }
        },
        "running": {
          "on": {
            "I_DONE": {
              "target": "idle",
              "guard": "inspectorRunCanEnd"
            },
            "DIALOG_TIMEOUT": {
              "target": "idle",
              "guard": "inspectorRunHitDialog",
              "actions": "stopInspectorAction"
            },
            "TAB_CLOSE": {
              "target": "idle",
              "guard": "inspectorTabCloses"
            },
            "BROWSER_GONE": {
              "target": "idle",
              "guard": "browserCanGo"
            },
            "STOP_DONE": {
              "target": "idle",
              "guard": "canEndSession"
            }
          }
        }
      }
    }
  }
}
