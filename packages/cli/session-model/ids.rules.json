      "min": 1,
      "max": 2
    },
    "dialog": {
      "min": 0,
      "max": 2
    },
    "hasGood": "bool",
    "lastFailed": "bool",
    "aTab": {
      "min": 1,
      "max": 2
    },
    "aClose": "bool",
    "wTab": {
      "min": 1,
      "max": 2
    },
    "orph1": "bool",
    "orph2": "bool",
    "win1": "bool",
    "win2": "bool",
