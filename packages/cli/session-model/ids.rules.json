      "lastFailed": false,
      "aTab": 1,
      "aClose": false,
      "wTab": 1,
      "orph1": false,
      "orph2": false,
      "win1": false,
      "win2": false,
      "pickBy": 0,
      "pickAsk": 0,
      "listFirstLine": "none",
      "swappedUnderPageWork": false,
      "closedByAyme": "none",
      "scheme": "session",
      "id1": 0,
      "id2": 0,
      "g1": 0,
      "g2": 0,
      "hw": 0,
      "renamePending": false,
      "idReused": false
    },
    {
      "ext": 0,
      "owned": false,
      "browserUp": false,
      "record": false,
      "active": 1,
      "dialog": 0,
      "hasGood": false,
      "lastFailed": false,
      "aTab": 1,
      "aClose": false,
      "wTab": 1,
      "orph1": false,
      "orph2": false,
      "win1": false,
      "win2": false,
      "pickBy": 0,
      "pickAsk": 0,
      "listFirstLine": "none",
      "swappedUnderPageWork": false,
      "closedByAyme": "none",
      "scheme": "perPage",
      "id1": 0,
      "id2": 0,
      "g1": 0,
      "g2": 0,
      "hw": 0,
      "renamePending": false,
      "idReused": false
    }
  ],
  "guards": {
    "outside": "ext < 5",
    "canStart": "ext < 5",
    "browserCanGo": "ext < 5",
    "stopAsked": "in('agent.stopping') && in('life.running')",
    "abandonedWorkEnds": "event.tab == 1 ? (orph1 && (in('life.running.tab.working') && active == 1) && dialog != 1) : (orph2 && (in('life.running.tab.working') && active == 2) && dialog != 2)",
    "canNavigate": "ext < 5 && in('life.running.browser.connected') && (event.tab == 1 ? id1 != 0 : id2 != 0)",
    "canRead": "in('life.running.browser.connected') && hasGood && (event.tab == 1 ? id1 == 0 : id2 == 0)",
    "canOpenDialog": "false",
    "dialogIsOpen": "ext < 5 && dialog != 0",
    "buildOk": "event.ok",
    "canEdit": "ext < 5",
    "canSwap": "!in('agent.callRunning') && !in('window.callRunning')",
    "canSwitchTab": "ext < 5 && event.tab != active",
    "canHideTab": "false",
    "canOpenWindow": "false",
    "closesLastWindow": "ext < 5 && (event.w == 1 ? (win1 && !win2) : (win2 && !win1))",
    "closesAWindow": "ext < 5 && (event.w == 1 ? win1 : win2)",
    "closesPicker": "ext < 5 && event.w == pickBy && (event.w == 1 ? win1 : win2)",
    "canAskPick": "ext < 5 && pickAsk == 0 && (event.w == 1 ? win1 : win2)",
    "pickIsStarting": "pickAsk != 0",
    "askWithoutSession": "ext < 5 && in('life.noSession')",
    "canAsk": "false",
    "agentTabHasDialog": "dialog != 0 && dialog == aTab",
    "agentCanList": "in('life.running.browser.connected') && dialog != aTab && (hasGood || in('life.running.pageObjects.failed')) && !((in('agent.callRunning') && aTab == aTab) || (in('window.callRunning') && wTab == aTab) || (aTab == 1 ? orph1 : orph2))",
    "agentTabHidden": "in('life.running.browser.connected') && !(in('life.running.tab.working') && active == aTab)",
    "noGoodPageObjects": "in('life.running.pageObjects.failed') && !hasGood",
    "agentCanStart": "in('life.running.browser.connected') && (in('life.running.tab.working') && active == aTab) && dialog != aTab && hasGood && !((in('agent.callRunning') && aTab == aTab) || (in('window.callRunning') && wTab == aTab) || (aTab == 1 ? orph1 : orph2))",
    "agentPageFree": "(in('life.running.tab.working') && active == aTab) && dialog != aTab",
    "canRun": "false",
    "windowTabHasDialog": "dialog != 0 && dialog == wTab",
    "windowTabHidden": "in('life.running.browser.connected') && !(in('life.running.tab.working') && active == wTab)",
    "windowCanStart": "in('life.running.browser.connected') && (in('life.running.tab.working') && active == wTab) && dialog != wTab && hasGood && !((in('agent.callRunning') && aTab == wTab) || (in('window.callRunning') && wTab == wTab) || (wTab == 1 ? orph1 : orph2))",
    "windowPageFree": "(in('life.running.tab.working') && active == wTab) && dialog != wTab"
  },
  "actions": {
    "countOutside": {
      "ext": "ext + 1"
    },
    "startOwnBrowser": {
      "ext": "ext + 1",
      "record": "true",
      "owned": "true",
      "browserUp": "true"
    },
    "joinBrowser": {
      "ext": "ext + 1",
      "record": "true",
      "owned": "false",
      "browserUp": "true"
    },
    "browserGone": {
      "ext": "ext + 1",
      "dialog": "0",
      "hasGood": "false",
      "lastFailed": "false",
      "orph1": "false",
      "orph2": "false",
      "win1": "false",
      "win2": "false",
      "pickBy": "0",
      "pickAsk": "0",
      "active": "1",
      "id1": "0",
      "id2": "0",
      "g1": "0",
      "g2": "0",
      "hw": "max(hw, max(g1, g2))",
      "renamePending": "false",
      "record": "false",
      "browserUp": "false"
    },
    "endSession": {
      "dialog": "0",
      "hasGood": "false",
      "lastFailed": "false",
      "orph1": "false",
      "orph2": "false",
      "win1": "false",
      "win2": "false",
      "pickBy": "0",
      "pickAsk": "0",
      "active": "1",
      "id1": "0",
      "id2": "0",
      "g1": "0",
      "g2": "0",
      "hw": "max(hw, max(g1, g2))",
      "renamePending": "false",
      "record": "false",
      "browserUp": "(aClose && owned) ? false : browserUp",
      "closedByAyme": "aClose ? (owned ? 'owned' : closedByAyme) : closedByAyme"
    },
    "endAbandonedWork": {
      "orph1": "event.tab == 1 ? false : orph1",
      "orph2": "event.tab == 2 ? false : orph2"
    },
    "openDialog": {
      "ext": "ext + 1",
      "dialog": "event.tab"
    },
    "answerDialog": {
      "ext": "ext + 1",
      "dialog": "0"
    },
    "keepBuild": {
      "hasGood": "true",
      "lastFailed": "false"
    },
    "failBuild": {
      "lastFailed": "true"
    },
    "edit": {
      "ext": "ext + 1",
      "renamePending": "renamePending || event.rename"
    },
    "swap": {
      "swappedUnderPageWork": "swappedUnderPageWork || orph1 || orph2",
      "id1": "renamePending ? 0 : id1",
      "id2": "renamePending ? 0 : id2",
      "renamePending": "false"
    },
    "switchTab": {
      "ext": "ext + 1",
      "active": "event.tab"
    },
    "openWindow": {
      "ext": "ext + 1",
      "win1": "event.w == 1 ? true : win1",
      "win2": "event.w == 2 ? true : win2"
    },
    "closeWindow": {
      "ext": "ext + 1",
      "win1": "event.w == 1 ? false : win1",
      "win2": "event.w == 2 ? false : win2"
    },
    "closeWindowEndPick": {
      "ext": "ext + 1",
      "win1": "event.w == 1 ? false : win1",
      "win2": "event.w == 2 ? false : win2",
      "pickBy": "0"
    },
    "askPick": {
      "ext": "ext + 1",
      "pickAsk": "event.w"
    },
    "beginPick": {
      "pickBy": "pickAsk",
      "pickAsk": "0"
    },
    "endPick": {
      "ext": "ext + 1",
      "pickBy": "0"
    },
    "answerNoSession": {
      "ext": "ext + 1"
    },
    "askList": {
      "ext": "ext + 1",
      "aTab": "event.tab",
      "listFirstLine": "'none'"
    },
    "askCall": {
      "ext": "ext + 1",
      "aTab": "event.tab"
    },
    "askDetach": {
      "ext": "ext + 1",
      "aClose": "false"
    },
    "askClose": {
      "ext": "ext + 1",
      "aClose": "true"
    },
    "answerList": {
      "listFirstLine": "in('life.running.pageObjects.failed') ? 'tabAndFailing' : (lastFailed ? 'tabWhileLastBuildFailed' : 'tab')"
    },
    "abandonAgentCall": {
      "orph1": "aTab == 1 ? true : orph1",
      "orph2": "aTab == 2 ? true : orph2"
    },
    "askRun": {
      "ext": "ext + 1",
      "wTab": "event.tab"
    },
    "abandonWindowCall": {
      "orph1": "wTab == 1 ? true : orph1",
      "orph2": "wTab == 2 ? true : orph2"
    },
    "navigate": {
      "ext": "ext + 1",
      "id1": "event.tab == 1 ? 0 : id1",
      "id2": "event.tab == 2 ? 0 : id2"
    },
    "read": {
      "id1": "event.tab == 1 ? (scheme == 'session' ? g1 + 1 : (event.tab == 1 ? g1 + 1 : g2 + 1)) : id1",
      "id2": "event.tab == 2 ? (scheme == 'session' ? g1 + 1 : (event.tab == 1 ? g1 + 1 : g2 + 1)) : id2",
      "g1": "(scheme == 'session' || event.tab == 1) ? g1 + 1 : g1",
      "g2": "(scheme == 'perPage' && event.tab == 2) ? g2 + 1 : g2",
      "idReused": "idReused || (scheme == 'session' ? g1 + 1 : (event.tab == 1 ? g1 + 1 : g2 + 1)) <= hw"
    }
  },
