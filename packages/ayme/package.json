{
  "name": "@ayme-dev/ayme",
  "version": "0.1.0",
  "description": "Ayme main library.",
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayme-labs/ayme.git",
    "directory": "packages/ayme"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./internal": {
      "types": "./dist/internal.d.mts",
      "import": "./dist/internal.mjs",
      "default": "./dist/internal.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs",
      "default": "./dist/server.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "vitest run --config vitest.browser.config.ts",
    "test:package": "vitest run src/packedConsumer.test.ts",
    "typecheck": "tsc --noEmit",
    "test:crap": "vitest run --config vitest.fast.config.ts --coverage",
    "test:mutation": "stryker run"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.29 <1.65",
    "@ayme-dev/inspector": "workspace:*",
    "@ayme-dev/mcp": "workspace:*",
    "@ayme-dev/webmcp": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "@ayme-dev/inspector": {
      "optional": true
    },
    "@ayme-dev/mcp": {
      "optional": true
    },
    "@ayme-dev/webmcp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ayme-dev/core": "workspace:*",
    "@ayme-dev/eslint-config": "workspace:*",
    "@ayme-dev/mcp": "workspace:*",
    "@ayme-dev/playwright-lite": "github:ayme-labs/playwright-lite#cd81df2eb2887e4b3bdfb3dba3cda29f29f4075e",
    "@ayme-dev/test-config": "workspace:*",
    "@ayme-dev/typescript-config": "workspace:*",
    "@playwright/test": "^1.64.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^24.0.0",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "playwright": "^1.64.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
