{
  // The compiler tests build a TypeScript program from the nearest tsconfig.
  // Without this one, each program would also load the whole package and its
  // dependencies' types (Vite, Rolldown, Node): twice the files, and twice the
  // compiler tests' time on CI. It repeats the workspace's library settings
  // rather than extending them; see target.
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // The floor of the TypeScript peer range, 5.4, knows no newer target,
    // and rejects one in a tsconfig this one extends.
    "target": "ES2022"
  }
}
