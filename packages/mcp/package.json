{
  "name": "@ayme-dev/mcp",
  "version": "0.1.0",
  "description": "Ayme's MCP server for coding agents, and the page client it pairs with.",
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayme-labs/ayme.git",
    "directory": "packages/mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "bin": {
    "ayme": "./dist/cli.mjs"
  },
  "exports": {
    "./client": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs",
      "default": "./dist/client.mjs"
    },
    "./testing": {
      "types": "./dist/testing.d.mts",
      "import": "./dist/testing.mjs",
      "default": "./dist/testing.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "ws": "^8.22.0",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.29 <1.63"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ayme-dev/eslint-config": "workspace:*",
    "@ayme-dev/typescript-config": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "eslint": "^10.9.1",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vite": "~8.2.2",
    "vitest": "^4.1.11"
  }
}
