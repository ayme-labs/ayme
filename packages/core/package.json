{
  "name": "@ayme-dev/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./structural-observation": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./structural-observation/testing": {
      "types": "./dist/testing.d.mts",
      "import": "./dist/testing.mjs",
      "default": "./dist/testing.mjs"
    }
  },
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "test:crap": "vitest run --config vitest.fast.config.ts --coverage",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@ayme-dev/eslint-config": "workspace:*",
    "@ayme-dev/test-config": "workspace:*",
    "@ayme-dev/typescript-config": "workspace:*",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "license": "FSL-1.1-ALv2",
  "description": "Shared structural observation, capture history, and projection"
}
