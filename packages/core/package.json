{
  "name": "@ayme-dev/core",
  "version": "0.1.0-alpha.2",
  "type": "module",
  "exports": {
    "./structural-observation": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./structural-observation/testing": {
      "types": "./dist/testing.d.mts",
      "import": "./dist/testing.mjs",
      "default": "./dist/testing.mjs"
    }
  },
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "test:package": "node scripts/verify-package.mjs",
    "test:e2e": "node scripts/verify-package.mjs --built"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@ayme-dev/eslint-config": "workspace:*",
    "@ayme-dev/typescript-config": "workspace:*",
    "eslint": "^10.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "tsdown": "^0.22.14"
  },
  "license": "FSL-1.1-ALv2",
  "description": "Shared structural observation, capture history, and projection",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayme-labs/ayme.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  }
}
