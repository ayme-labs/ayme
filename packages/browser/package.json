{
  "name": "@ayme-dev/browser",
  "version": "0.0.0",
  "private": true,
  "description": "Gets ayme a browser: finds the project's own Playwright, starts Chromium or joins a running browser, and releases it",
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./playwright-range.json": "./playwright-range.json"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:compat": "vitest run --config vitest.compat.config.ts",
    "typecheck": "tsc --noEmit",
    "test:crap": "vitest run --config vitest.crap.config.ts --coverage",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "effect": "^4.1.4"
  },
  "devDependencies": {
    "@ayme-dev/eslint-config": "workspace:*",
    "@ayme-dev/test-config": "workspace:*",
    "@ayme-dev/typescript-config": "workspace:*",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.9.1",
    "playwright-core": "^1.64.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
