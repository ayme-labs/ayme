{
  "name": "@ayme-dev/webmcp-inspector",
  "version": "0.1.0",
  "description": "Browser Inspector for Ayme Page Object Models.",
  "license": "FSL-1.1-ALv2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./demo": {
      "types": "./dist/demo.d.mts",
      "import": "./dist/demo.mjs",
      "default": "./dist/demo.mjs"
    },
    "./testing": {
      "types": "./dist/testing.d.mts",
      "import": "./dist/testing.mjs",
      "default": "./dist/testing.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint src tests --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test --reporter=list",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json"
  },
  "dependencies": {
    "@ayme-dev/webmcp": "workspace:*",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.29 <1.63"
  },
  "devDependencies": {
    "@ayme-dev/design-system": "workspace:*",
    "@ayme-dev/eslint-config": "workspace:*",
    "@ayme-dev/playwright-lite": "github:ayme-labs/playwright-lite#5c088c47f271e361e8e07620c3c4f65eab02c430",
    "@ayme-dev/typescript-config": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/browser-playwright": "^4.1.11",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.0.0",
    "playwright": "^1.62.1",
    "sugar-high": "^2.4.1",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
