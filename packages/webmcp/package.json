{
  "name": "@ayme-dev/webmcp",
  "version": "0.1.0",
  "description": "Publishing Ayme's tools through WebMCP, for agents that run in the browser.",
  "keywords": [
    "ai-agent",
    "coding-agent",
    "mcp",
    "webmcp",
    "browser-automation",
    "playwright",
    "page-object-model",
    "testing",
    "e2e"
  ],
  "homepage": "https://ayme.dev",
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayme-labs/ayme.git",
    "directory": "packages/webmcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./testing": {
      "types": "./dist/testing.d.mts",
      "import": "./dist/testing.mjs",
      "default": "./dist/testing.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc --noEmit",
    "test:crap": "vitest run --config vitest.fast.config.ts --coverage",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@mcp-b/webmcp-types": "^5.0.1"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.29 <1.65"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ayme-dev/ayme": "workspace:*",
    "@ayme-dev/eslint-config": "workspace:*",
    "@ayme-dev/test-config": "workspace:*",
    "@ayme-dev/typescript-config": "workspace:*",
    "@playwright/test": "^1.64.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "playwright": "^1.64.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
