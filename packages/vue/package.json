{
  "name": "@ayme-dev/vue",
  "version": "0.1.0",
  "description": "Starting Ayme in a Vue app and Page Objects in components.",
  "keywords": [
    "ai-agent",
    "coding-agent",
    "mcp",
    "webmcp",
    "browser-automation",
    "playwright",
    "page-object-model",
    "testing",
    "e2e",
    "vue",
    "nuxt"
  ],
  "homepage": "https://ayme.dev",
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayme-labs/ayme.git",
    "directory": "packages/vue"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./absent": {
      "types": "./dist/absent.d.mts",
      "import": "./dist/absent.mjs",
      "default": "./dist/absent.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "test:crap": "vitest run --config vitest.fast.config.ts --coverage",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@ayme-dev/ayme": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@ayme-dev/eslint-config": "workspace:*",
    "@ayme-dev/test-config": "workspace:*",
    "@ayme-dev/typescript-config": "workspace:*",
    "@ayme-dev/webmcp": "workspace:*",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/server-renderer": "^3.5.42",
    "eslint": "^10.9.1",
    "playwright": "^1.64.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "vue": "^3.5.42"
  }
}
