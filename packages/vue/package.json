{
  "name": "@ayme-dev/vue",
  "version": "0.1.0",
  "description": "Vue integration for Ayme.",
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayme-labs/ayme.git",
    "directory": "packages/vue"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ayme-dev/ayme": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@ayme-dev/eslint-config": "workspace:*",
    "@ayme-dev/typescript-config": "workspace:*",
    "@ayme-dev/webmcp": "workspace:*",
    "@vitest/browser-playwright": "^4.1.11",
    "@vue/server-renderer": "^3.5.42",
    "eslint": "^10.9.1",
    "playwright": "^1.62.1",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "vue": "^3.5.42"
  }
}
