  "description": "Ayme's design system: palette, tokens, logos and React components shared across Ayme surfaces.",
  "license": "FSL-1.1-ALv2",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
