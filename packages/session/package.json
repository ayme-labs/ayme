{
  "name": "@ayme-dev/session",
  "version": "0.0.0",
  "private": true,
  "description": "The Session of the ayme command: one running ayme connected to one browser, in a background process the commands talk to",
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./testing": "./testing/index.ts"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint src testing --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:crap": "vitest run --config vitest.fast.config.ts --coverage",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "effect": "^4.1.4",
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@ayme-dev/browser": "workspace:*",
    "@ayme-dev/eslint-config": "workspace:*",
    "@ayme-dev/test-config": "workspace:*",
    "@ayme-dev/typescript-config": "workspace:*",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.9.1",
    "playwright-core": "^1.64.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
