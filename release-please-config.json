{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "initial-version": "0.1.0",
  "bump-minor-pre-major": true,
  "bootstrap-sha": "8957c3ef8b26aee75830c337d129cfa6c75b1a28",
  "group-pull-request-title-pattern": "chore: release ${branch}",
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "ayme",
      "components": [
        "angular",
        "ayme",
        "inspector",
        "mcp",
        "react",
        "svelte",
        "unplugin-ayme",
        "vue",
        "webmcp"
      ],
      "merge": false
    }
  ],
  "packages": {
    "packages/angular": { "component": "angular" },
    "packages/ayme": { "component": "ayme" },
    "packages/inspector": { "component": "inspector" },
    "packages/mcp": { "component": "mcp" },
    "packages/react": { "component": "react" },
    "packages/svelte": { "component": "svelte" },
    "packages/unplugin-ayme": { "component": "unplugin-ayme" },
    "packages/vue": { "component": "vue" },
    "packages/webmcp": { "component": "webmcp" }
  }
}
