stateDiagram-v2
  state "Legend" as legend {
    lg0: Breaks R01_HeldClickReachesThePageOnce or R03a_StoppedClicksAreUntouched or R03b_StoppedAddsNothing
    lg1: Path to the R01_HeldClickReachesThePageOnce or R03a_StoppedClicksAreUntouched or R03b_StoppedAddsNothing bug
  }
  class lg0 breaks
  class lg1 bugPath
  s0: Not recording | gate off in the page
  s1: Recording | gate off in the page (switch-on on its way)
  s2: Recording | gate ON in the page
  s3: Wrapping up to clear | gate ON in the page (switch-off on its way)
  s4: Wrapping up to pause | gate ON in the page (switch-off on its way)
  s5: Paused | gate ON in the page (switch-off on its way)
  s6: Wrapping up to clear and end | gate ON in the page (switch-off on its way)
  s7: Ended: nothing to save | gate ON in the page
  s8: Paused | gate ON in the page (switch-off on its way) | click 1: held back, no 'before' yet#59; no report#59; not in the timeline
  s9: Ended: nothing to save | gate ON in the page | click 1: held back, no 'before' yet#59; no report#59; not in the timeline
  s10: Recording | gate ON in the page | click 1: held back, no 'before' yet#59; no report#59; not in the timeline
  s11: Recording | gate ON in the page | click 1: held back, 'before' taken#59; no report#59; not in the timeline
  s12: Recording | gate ON in the page | click 1: reached the page#59; report on its way#59; not in the timeline
  s13: Recording | gate ON in the page | click 1: reached the page#59; report in#59; in the timeline (before 2, after -)
  [*] --> s0
  s0 --> s1: you press Record
  s1 --> s2: the page switches the gate on
  s2 --> s3: you press Clear
  s2 --> s4: you press Stop
  s3 --> s6: you stop the recorder from the terminal
  s4 --> s5: the recorder finishes wrapping up
  s5 --> s8: you click (click 1): the gate holds it back
  s6 --> s7: the recorder finishes wrapping up
  s7 --> s9: you click (click 1): the gate holds it back
  s8 --> s10: you press Continue
  s10 --> s11: the recorder takes the 'before' of click 1
  s11 --> s12: the recorder passes click 1 on to the page
  s12 --> s13: Playwright's report for 1 arrives: added to the timeline
