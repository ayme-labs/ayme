stateDiagram-v2
  state "Legend" as legend {
    lg0: Breaks X1_NothingOvertakesAHeldClick or X2_SnapshotsInTimeOrder
    lg1: Path to the X1_NothingOvertakesAHeldClick or X2_SnapshotsInTimeOrder bug
  }
  class lg0 breaks
  class lg1 bugPath
  s0: Not recording | gate off in the page
  s1: Recording | gate off in the page (switch-on on its way)
  s2: Recording | gate ON in the page
  s3: Recording | gate ON in the page | click 1: held back, no 'before' yet#59; no report#59; not in the timeline
  s4: Recording | gate ON in the page | click 1: held back, no 'before' yet#59; no report#59; not in the timeline | typing 2: reached the page#59; report on its way#59; not in the timeline
  s5: Recording | gate ON in the page | click 1: held back, no 'before' yet#59; no report#59; not in the timeline | typing 2: reached the page#59; report in#59; in the timeline (before 1, after -)
  s6: Recording | gate ON in the page | click 1: held back, 'before' taken#59; no report#59; not in the timeline | typing 2: reached the page#59; report in#59; in the timeline (before 1, after -)
  s7: Recording | gate ON in the page | click 1: reached the page#59; report on its way#59; not in the timeline | typing 2: reached the page#59; report in#59; in the timeline (before 1, after -)
  s8: Recording | gate ON in the page | click 1: reached the page#59; report in#59; in the timeline (before 2, after 3) | typing 2: reached the page#59; report in#59; in the timeline (before 1, after -)
  [*] --> s0
  s0 --> s1: you press Record
  s1 --> s2: the page switches the gate on
  s2 --> s3: you click (click 1): the gate holds it back
  s3 --> s4: you type (typing 2): it reaches the page at once
  s4 --> s5: Playwright's report for 2 arrives: added to the timeline
  s5 --> s6: the recorder takes the 'before' of click 1
  s6 --> s7: the recorder passes click 1 on to the page
  s7 --> s7: the page settles: the recorder takes the 'after' of 1
  s7 --> s8: Playwright's report for 1 arrives: added to the timeline
