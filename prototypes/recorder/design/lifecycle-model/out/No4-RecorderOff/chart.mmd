stateDiagram-v2
  state "Legend" as legend {
    lg0: Breaks R03a_StoppedClicksAreUntouched or R03b_StoppedAddsNothing
    lg1: Path to the R03a_StoppedClicksAreUntouched or R03b_StoppedAddsNothing bug
  }
  class lg0 breaks
  class lg1 bugPath
  s0: Not recording | gate off in the page
  s1: Not recording | gate off in the page | click 1: reached the page#59; report on its way#59; not in the timeline
  s2: Recording | gate off in the page (switch-on on its way)
  s3: Recording, Playwright is picking | gate off in the page (switch-on on its way)
  s4: Recording | gate off in the page (switch-on on its way) | click 1: reached the page#59; report on its way#59; not in the timeline
  s5: Recording | gate off in the page (switch-on on its way) | click 1: reached the page#59; report in#59; in the timeline (before 1, after -)
  s6: Wrapping up to pause, Playwright is picking | gate off in the page
  s7: Paused, Playwright is picking | gate off in the page
  s8: Paused | gate off in the page | click 1: picked for an assertion#59; report on its way#59; not in the timeline
  [*] --> s0
  s0 --> s1: you click (click 1): it reaches the page untouched
  s0 --> s2: you press Record
  s1 --> s4: you press Record
  s2 --> s3: you press Assert visibility
  s3 --> s6: you press Stop
  s4 --> s5: Playwright's report for 1 arrives: added to the timeline
  s6 --> s7: the recorder finishes wrapping up
  s7 --> s8: you click (click 1): Playwright's picker swallows it
  classDef breaks fill:#ffecee,stroke:#e72e3b,stroke-width:2.5px,color:#cd2834
