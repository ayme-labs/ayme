{
  "name": "ayme",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "turbo run build",
    "boundaries": "turbo boundaries",
    "check": "pnpm run boundaries && pnpm run docs:check && pnpm run test:scripts && pnpm run build && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run test:e2e && pnpm run format:check",
    "prepare": "lefthook install",
    "release:version": "node scripts/release-version.mjs",
    "hooks:install": "lefthook install",
    "commitlint": "commitlint --verbose",
    "docs:check": "node --test scripts/check-docs.test.mjs && node scripts/check-docs.mjs",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "typecheck": "turbo run typecheck",
    "analyze:changed": "node scripts/analyze-changed.mjs",
    "test:scripts": "node --test scripts/analyze-changed.test.mjs scripts/mutation-survivors.test.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/types": "^21.0.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.9.1",
    "lefthook": "^2.1.8",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "turbo": "^2.11.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
