{
  "fileExtensions": ["ts", "tsx"],
  // Generated shadcn-vue components: each component imports its variants
  // from the index that re-exports it.
  "excludeRegExp": ["/fixtures/", "example-vue/src/components/ui/"],
  // Any tsconfig switches madge to TypeScript's resolver, which reads the
  // imports in Vue files instead of parsing the whole file as JavaScript.
  "tsConfig": "packages/typescript-config/base.json",
  "detectiveOptions": {
    "ts": { "skipTypeImports": true },
    "tsx": { "skipTypeImports": true }
  }
}
