{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:crap": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/crap/**"],
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"]
    },
    "test:mutation": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "PLAYWRIGHT_BROWSERS_PATH",
        "STRYKER_LANE",
        "STRYKER_SHARD"
      ]
    },
    "test:e2e": {
      "dependsOn": ["build", "^build"],
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH", "AYME_E2E_PORT_*"],
      "cache": false
    },
    "test:goals": {
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "PLAYWRIGHT_BROWSERS_PATH",
        "AYME_TYPESAFE_API_KEY",
        "AYME_OPENROUTER_API_KEY",
        "AYME_E2E_PORT_*"
      ],
      "cache": false
    }
  },
  "boundaries": {
    "tags": {
      "tooling": {
        "dependencies": {
          "deny": ["core", "adapter", "app"]
        }
      },
      "core": {
        "dependencies": {
          "deny": ["adapter", "app"]
        }
      },
      "adapter": {
        "dependencies": {
          "deny": ["app"]
        }
      },
      "design-system": {
        "dependencies": {
          "deny": ["core", "adapter", "app"]
        }
      }
    }
  }
}
