+describe('container keys for labelled containers and run data', () => {
+  /** Builds a node map and parent index from a list of nodes with their parent. */
+  function screenOf(entries: readonly [id: string, node: Omit<SemanticNode, 'ref' | 'children'>, parent?: string][]) {
+    const built = new Map<string, SemanticNode>();
+    const parents = new Map<string, string>();
+    for (const [id, node, parent] of entries) {
+      built.set(id, { ref: { id, revision: 'r' }, ...node });
+      if (parent !== undefined) parents.set(id, parent);
+    }
+    for (const [id, parent] of parents) {
+      const owner = built.get(parent)!;
+      built.set(parent, { ...owner, children: [...(owner.children ?? []), built.get(id)!] });
+    }
+    // Children are built bottom-up above; re-read them so every level carries its final children.
+    const resolve = (node: SemanticNode): SemanticNode => ({ ...node, ...(node.children === undefined ? {} : { children: node.children.map((child) => resolve(built.get(child.ref.id)!)) }) });
+    const nodes = new Map<string, RedactedNode>([...built].map(([id, node]) => [id, redacted(resolve(node))]));
+    return { nodes, parents };
+  }
+
