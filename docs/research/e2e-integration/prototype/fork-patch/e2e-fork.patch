+    // The same control at another count: same key, so a recording replays whatever the count.
+    expect(containerKey('b', at5.nodes, at5.parents)).toBe('Counter');
+    expect(relocateDescriptor({ role: 'button', name: 'Increment', within: 'Counter' }, at5.nodes)).toEqual({ kind: 'found', id: 'b' });
+  });
+
