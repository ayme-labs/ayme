+
+describe('replayTrace tool calls', () => {
+  const createProject: RecordedAction = { name: 'tool', summary: 'tool P_create {"name":"Acme"}', tool: 'P_create', args: { name: 'Acme' } };
+
+  it('runs a recorded tool call through the host with its recorded input, then the rest of the trace', async () => {
+    const ran: unknown[] = [];
+    const host = { ...makeHost({}), runTool: async (tool: string, args: unknown) => void ran.push([tool, args]) };
+    const outcome = await replayTrace(host, trace([createProject, tapUpgrade]));
+    expect(outcome).toMatchObject({ completed: true, executed: 2 });
+    expect(ran).toEqual([['P_create', { name: 'Acme' }]]);
+    expect(host.calls).toEqual(['tap']);
+  });
+
+  it('hands off as a failed action when the tool throws', async () => {
+    const host = { ...makeHost({}), runTool: () => Promise.reject(new Error('locator not found')) };
+    const outcome = await replayTrace(host, trace([tapUpgrade, createProject]));
+    expect(outcome).toMatchObject({ completed: false, executed: 1, stopReason: 'action-failed' });
+  });
+
+  it('stops at a recorded call as a gap when the host runs no tools, and at a bare gap whatever it runs', async () => {
+    await expect(replayTrace(makeHost({}), trace([createProject]))).resolves.toMatchObject({ completed: false, stopReason: 'gap' });
+    const host = { ...makeHost({}), runTool: () => Promise.resolve() };
+    await expect(replayTrace(host, trace([{ name: 'tool', summary: 'tool X' }]))).resolves.toMatchObject({ stopReason: 'gap' });
+  });
+});
+
+describe('replayTrace failed tool calls', () => {
+  it('names the failed call and the first line of its error', async () => {
+    const call: RecordedAction = { name: 'tool', summary: 'tool P_create', tool: 'P_create', args: { name: 'Acme' } };
+    const host = { ...makeHost({}), runTool: () => Promise.reject(new Error('Timeout 5000ms exceeded.\nwaiting for getByRole')) };
+    await expect(replayTrace(host, trace([call]))).resolves.toMatchObject({
+      stopReason: 'action-failed',
+      executed: 0,
+      failedTool: { tool: 'P_create', args: { name: 'Acme' }, error: 'Timeout 5000ms exceeded.' },
+    });
+  });
+});
