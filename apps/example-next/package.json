{
  "name": "@ayme-dev/example-next",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4192",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 4192",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test:e2e": "pnpm run test:e2e:dev && pnpm run test:e2e:prod",
    "test:e2e:dev": "playwright test",
    "test:e2e:prod": "playwright test --config=playwright.production.config.ts"
  },
  "dependencies": {
    "@ayme-dev/ayme": "workspace:*",
    "@ayme-dev/react": "workspace:*",
    "next": "16.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@ayme-dev/eslint-config": "workspace:*",
    "@ayme-dev/typescript-config": "workspace:*",
    "@ayme-dev/unplugin-ayme": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@playwright/test": "~1.62.1",
    "playwright": "~1.62.1",
    "typescript": "^6.0.3",
    "eslint": "^10.9.1"
  }
}
