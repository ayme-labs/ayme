{
  "name": "@ayme-dev/example-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/verify-browser-output.mjs",
    "dev": "vite --host 127.0.0.1 --port 4190 --strictPort",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test --config playwright.config.ts --reporter=list",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ayme-dev/webmcp": "workspace:*",
    "@ayme-dev/webmcp-inspector": "workspace:*",
    "@ayme-dev/webmcp-vue": "workspace:*",
    "vue": "^3.5.42",
    "@mcp-b/webmcp-polyfill": "5.1.0",
    "@ayme-dev/playwright-lite": "github:ayme-labs/playwright-lite#8adaf9aac567570423379f87d2d412171baecd98"
  },
  "devDependencies": {
    "@ayme-dev/eslint-config": "workspace:*",
    "@ayme-dev/typescript-config": "workspace:*",
    "@ayme-dev/unplugin-webmcp": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
