{
  "name": "@ayme-dev/example-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --mode without-ayme && node scripts/verify-browser-output.mjs",
    "dev": "vite --host 127.0.0.1 --port 4190 --strictPort",
    "goals:runs": "node scripts/goal-runs.ts",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "pnpm run test:e2e:dev && pnpm run test:e2e:prod",
    "test:e2e:dev": "AYME_E2E_RENDER=spa playwright test && playwright test --config playwright.benchScripted.config.ts",
    "test:e2e:prod": "AYME_E2E_SERVER=production AYME_E2E_RENDER=spa playwright test",
    "test:goals": "playwright test --config playwright.goals.config.ts --reporter=list",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ayme-dev/ayme": "workspace:*",
    "@ayme-dev/inspector": "workspace:*",
    "@ayme-dev/mcp": "workspace:*",
    "@ayme-dev/playwright-lite": "github:ayme-labs/playwright-lite#83c2cd7ddda45c1c7a494c4556fbae29ec46933a",
    "@ayme-dev/vue": "workspace:*",
    "@ayme-dev/webmcp": "workspace:*",
    "@lucide/vue": "^1.47.0",
    "@mcp-b/webmcp-polyfill": "5.1.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.10.4",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "urlpattern-polyfill": "^10.1.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@ayme-dev/eslint-config": "workspace:*",
    "@ayme-dev/example-certification": "workspace:*",
    "@ayme-dev/typescript-config": "workspace:*",
    "@ayme-dev/unplugin-ayme": "workspace:*",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.64.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
