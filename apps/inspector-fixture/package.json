{
  "name": "@ayme-dev/inspector-fixture",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#pom/*": "./ayme/pom/*.ts"
  },
  "scripts": {
    "dev": "vite --config app/vite.config.ts",
    "lint": "eslint . --max-warnings 0",
    "test:e2e": "pnpm run test:playwright && pnpm run test:e2e:e2e",
    "test:playwright": "playwright test --reporter=list",
    "test:e2e:e2e": "e2e run",
    "test:tools-check": "e2e-patched run --config e2e.tools-check.config.ts",
    "test:goals:tools": "e2e-patched run --config e2e.goals-tools.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ayme"
  },
  "dependencies": {
    "@ayme-dev/ayme": "workspace:*",
    "@ayme-dev/inspector": "workspace:*",
    "@ayme-dev/mcp": "workspace:*",
    "@ayme-dev/webmcp": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.112.0",
    "@ayme-dev/e2e-testing": "workspace:*",
    "@ayme-dev/e2e-tools": "workspace:*",
    "@ayme-dev/eslint-config": "workspace:*",
    "@ayme-dev/typescript-config": "workspace:*",
    "@ayme-dev/unplugin-ayme": "workspace:*",
    "@e2e-dev/acp": "0.1.3",
    "@e2e-dev/web": "0.17.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "e2e": "0.25.0",
    "eslint": "^10.9.1",
    "playwright": "^1.64.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  }
}
