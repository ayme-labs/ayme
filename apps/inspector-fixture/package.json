{
  "name": "@ayme-dev/inspector-fixture",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#pom/*": "./ayme/pom/*.ts"
  },
  "scripts": {
    "dev": "vite --config app/vite.config.ts",
    "check:goal-mirror": "node scripts/check-goal-mirror.mjs",
    "lint": "eslint . --max-warnings 0 && node scripts/check-goal-mirror.mjs",
    "e2e": "E2E_TELEMETRY_DISABLED=1 e2e run",
    "test:e2e": "playwright test --reporter=list",
    "test:goals": "E2E_TELEMETRY_DISABLED=1 e2e run --config e2e.goals.config.ts --cache-dir .e2e/goals-cache",
    "test:goals:tools": "E2E_TELEMETRY_DISABLED=1 e2e-patched run --config e2e.goals-tools.config.ts --cache-dir .e2e/goals-tools-cache",
    "test:goals:tools:scripted": "AYME_E2E_EXECUTOR=scripted E2E_TELEMETRY_DISABLED=1 e2e-patched run --config e2e.goals-tools.config.ts --cache-dir .e2e/goals-tools-scripted-cache",
    "test:tools-check": "E2E_TELEMETRY_DISABLED=1 e2e-patched run --config e2e.tools-check.config.ts",
    "study:baseline": "node scripts/study-baseline.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ayme",
    "test": "node --test scripts/check-goal-mirror.test.mjs scripts/study-report.test.mjs"
  },
  "dependencies": {
    "@ayme-dev/ayme": "workspace:*",
    "@ayme-dev/inspector": "workspace:*",
    "@ayme-dev/mcp": "workspace:*",
    "@ayme-dev/webmcp": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.112.0",
    "@ayme-dev/e2e-tools": "workspace:*",
    "@ayme-dev/eslint-config": "workspace:*",
    "@ayme-dev/typescript-config": "workspace:*",
    "@ayme-dev/unplugin-ayme": "workspace:*",
    "@e2e-dev/acp": "0.1.3",
    "@e2e-dev/web": "0.17.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "e2e": "0.25.0",
    "eslint": "^10.9.1",
    "playwright": "^1.64.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  }
}
