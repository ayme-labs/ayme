{
  "extends": "@ayme-dev/typescript-config/react-library.json",
  "compilerOptions": {
    "experimentalDecorators": true,
    "types": ["node"],
    // The e2e harness and `@ayme-dev/e2e` import with `.ts` extensions.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    // The Inspector's Page Object from source, as the Vite config resolves
    // it: the Ayme plugin reads its decorators, which the shipped
    // declarations drop.
    "paths": {
      "@ayme-dev/inspector/testing": [
        "../../packages/inspector/src/testing/index.ts"
      ]
    }
  },
  "include": ["app", "pom", "tests", "e2e", "*.ts"],
  "exclude": ["e2e/.e2e"]
}
