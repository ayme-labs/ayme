{
  "name": "@ayme-dev/example-react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4191 --strictPort",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test:e2e": "pnpm run test:e2e:dev && pnpm run test:e2e:prod",
    "test:e2e:dev": "AYME_E2E_RENDER=spa playwright test",
    "test:e2e:prod": "AYME_E2E_SERVER=production AYME_E2E_RENDER=spa playwright test"
  },
  "dependencies": {
    "@ayme-dev/ayme": "workspace:*",
    "@ayme-dev/inspector": "workspace:*",
    "@ayme-dev/mcp": "workspace:*",
    "@ayme-dev/react": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@ayme-dev/eslint-config": "workspace:*",
    "@ayme-dev/example-certification": "workspace:*",
    "@ayme-dev/typescript-config": "workspace:*",
    "@ayme-dev/unplugin-ayme": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@playwright/test": "^1.62.1",
    "playwright": "^1.62.1",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.2.2",
    "typescript": "^6.0.3",
    "eslint": "^10.9.1"
  }
}
